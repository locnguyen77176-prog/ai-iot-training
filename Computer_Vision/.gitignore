# ==============================================================================
#                      AI SMARTGATE - .gitignore
# ==============================================================================

# --- 1. Python Cache & Compiled Files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- 2. Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- 3. Local Environment & Secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
config.local.yaml
config.local.yml

# --- 4. Database & Runtime Data ---
*.db
*.sqlite
*.sqlite3
database.db
test_e2e_database.db
test_database.db

# --- 5. Uploaded Test Videos & Generated Review Artifacts ---
uploads/*
!uploads/.gitkeep
scratch/
scratch_benchmark/
scratch_review/
test_walking.mp4

# --- 6. Large Training/Export Artifacts (keep NCNN .param/.bin tracked) ---
*.pt
*.onnx
*.caffemodel
*.engine
*.tflite
*.torchscript
*.safetensors
datasets/calibration/

# --- 7. Temporary Files & Logs ---
*.log
*.tmp
*.temp
*.bak

# --- 8. IDE & Editor Files ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 9. OS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
