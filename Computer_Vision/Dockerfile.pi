FROM python:3.11-slim-bookworm AS ncnn-builder

ARG NCNN_VERSION=20260526
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ninja-build libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ${NCNN_VERSION} --depth 1 --recurse-submodules \
        https://github.com/Tencent/ncnn.git /tmp/ncnn
RUN EXTRA_CMAKE_ARGS="-DNCNN_VULKAN=OFF -DNCNN_OPENMP=ON -DNCNN_BUILD_TOOLS=OFF -DNCNN_BUILD_EXAMPLES=OFF -DNCNN_BUILD_BENCHMARK=OFF" \
    CMAKE_BUILD_PARALLEL_LEVEL=4 \
    python -m pip wheel --no-deps --wheel-dir /tmp/wheels /tmp/ncnn

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VISIONFLOW_CONFIG=config.pi.yaml \
    RUN_NCNN_SMOKE=1 \
    OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-pi.txt .
RUN python -m pip install --no-cache-dir -r requirements-pi.txt
COPY --from=ncnn-builder /tmp/wheels/ncnn-*.whl /tmp/
RUN python -m pip install --no-cache-dir --no-deps /tmp/ncnn-*.whl && rm /tmp/ncnn-*.whl

COPY . .
RUN chmod +x /app/docker/entrypoint.sh \
    && python -c "import cv2, ncnn, numpy, yaml; print('Runtime imports OK')" \
    && test -s models/yolo26n_ncnn_int8/model.ncnn.param \
    && test -s models/yolo26n_ncnn_int8/model.ncnn.bin \
    && test -s models/osnet_x0_25_ncnn_model/model.ncnn.param \
    && test -s models/osnet_x0_25_ncnn_model/model.ncnn.bin

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/camera/status', timeout=4).read()" || exit 1
ENTRYPOINT ["/app/docker/entrypoint.sh"]
